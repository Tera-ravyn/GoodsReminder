{
  "name": "goods-reminder",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "next dev",
    "electron": "electron .",
    "build": "next build"
  },
  "build": {
    "appId": "com.example.goods-reminder",
    "productName": "Goods Reminder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "goodsData.js",
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/**/{test,__tests__,tests,*.md,*.txt,*.spec.js,*.test.js}",
      "!node_modules/**/test*/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/README*",
      "!node_modules/**/LICENSE*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@tauri-apps/api": "^2.7.0",
    "next": "14.1.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}
